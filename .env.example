# Copy to .env and fill in real values. Never commit .env.

# development | production | test
FLASK_ENV=development
LOG_LEVEL=INFO

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-me-with-a-long-random-string

# Postgres connection. On Render, this is injected from the linked database.
DATABASE_URL=postgresql://user:password@localhost:5432/bankanalyzer

# Comma-separated allowed CORS origins. Leave empty to disable browser access.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Where uploaded files are written. Use ephemeral storage on Render (/tmp).
UPLOAD_FOLDER=/tmp/bankanalyzer-uploads

# Max upload size in bytes (5 MB default).
MAX_UPLOAD_BYTES=5242880

# JWT access token lifetime in minutes.
JWT_ACCESS_TTL_MINUTES=30

# Bcrypt work factor. Increase as hardware improves; re-evaluate annually.
BCRYPT_ROUNDS=12

# Optional: Redis URI for rate-limiter state across workers.
# RATELIMIT_STORAGE_URI=redis://localhost:6379
