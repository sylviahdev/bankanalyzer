# Copy to .env and fill in real values. Never commit .env.

# development | production | test
FLASK_ENV=development
LOG_LEVEL=INFO

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-me-with-a-long-random-string

# Postgres connection. Required — the app refuses to start without it.
# Local dev: postgresql://user:pass@localhost:5432/bankanalyzer
# On Render: do NOT set this manually — render.yaml wires it from the linked database.
# On Koyeb: paste the connection string from your Postgres provider (Neon,
# Supabase, Koyeb Postgres). `postgres://` is rewritten and sslmode=require is
# added automatically, so the provider's string can be pasted as-is.
DATABASE_URL=

# Comma-separated allowed CORS origins. Leave empty to disable browser access.
# In production set this to your deployed frontend origin, scheme included and
# no trailing slash, e.g. https://bankanalyzer.vercel.app
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Where uploaded files are written. Container filesystems on Render and Koyeb
# are ephemeral, so keep this under /tmp. Summary workbooks are rebuilt from the
# database when the file is gone, so nothing is lost on restart.
UPLOAD_FOLDER=/tmp/bankanalyzer-uploads

# Max upload size in bytes (5 MB default).
MAX_UPLOAD_BYTES=5242880

# JWT access token lifetime in minutes.
JWT_ACCESS_TTL_MINUTES=30

# How long a fully idle session can sit before the user must sign in again.
# Refresh tokens rotate on every use, so this is a ceiling, not a fixed window.
JWT_REFRESH_TTL_DAYS=14

# Required by the `flask db` migration commands, and by the Procfile's
# `flask db upgrade` step on hosts without a separate release phase (Koyeb).
FLASK_APP=wsgi.py

# Bcrypt work factor. Increase as hardware improves; re-evaluate annually.
BCRYPT_ROUNDS=12

# Optional: Redis URI for rate-limiter state across workers.
# RATELIMIT_STORAGE_URI=redis://localhost:6379

# Optional: JWT issuer/audience claims. Defaults are fine for a single deployment.
# JWT_ISSUER=bankanalyzer
# JWT_AUDIENCE=bankanalyzer-api

# PORT is supplied by the platform (Koyeb, Render). Do not set it in production;
# the Procfile falls back to 8000 for local runs.
# PORT=8000
