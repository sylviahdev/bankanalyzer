# Copy to .env.local and adjust. Never commit a real .env file.
#
# Base URL of the Flask API. The backend must list this app's origin in its
# CORS_ORIGINS variable (http://localhost:5173 is already in the backend's
# .env.example), otherwise the browser will block every request.
#
# Local development:
VITE_API_URL=http://127.0.0.1:8000
#
# Production (Render), for example:
# VITE_API_URL=https://bankanalyzer.onrender.com

# ISO 4217 currency code used to format amounts. The API stores plain numbers
# with no currency unit, so this is purely a display choice. Defaults to USD.
VITE_CURRENCY=USD

# Optional BCP 47 locale for number and date formatting.
# Leave unset to follow the browser's locale.
# VITE_LOCALE=en-GB
